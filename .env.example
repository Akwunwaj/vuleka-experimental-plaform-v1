COMPANY_OFFICE_BEARERS=
COMPANY_PHYSICAL_ADDRESS=
COMPANY_TELEPHONE=
INFORMATION_OFFICER_NAME=
INFORMATION_OFFICER_EMAIL=

SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_YAHOO_CLIENT_ID=
SOCIAL_YAHOO_CLIENT_SECRET=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_FACEBOOK_GRAPH_VERSION=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_APPLE_CLIENT_ID=
SOCIAL_APPLE_CLIENT_SECRET=

# Invisible reCAPTCHA v3 for all authentication and registration actions.
RECAPTCHA_MODE=disabled
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Google Drive knowledge connector. Register the callback URL in Google Cloud.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://app.chatclan.co.za/auth/google-drive/callback
# Full folder sync uses Google's restricted read-only Drive scope and requires the applicable verification/security review.
GOOGLE_DRIVE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly
GOOGLE_DRIVE_OAUTH_TEST_USERS=
GOOGLE_DRIVE_OAUTH_VERIFICATION_STATUS=not_started
GOOGLE_DRIVE_OAUTH_SECURITY_ASSESSMENT_STATUS=not_started
GOOGLE_DRIVE_OAUTH_REQUIRED=false

# Tenant CRM OAuth applications. Register each provider-specific callback URL.
CRM_HUBSPOT_OAUTH_CLIENT_ID=
CRM_HUBSPOT_OAUTH_CLIENT_SECRET=
CRM_HUBSPOT_OAUTH_REDIRECT_URI=https://app.chatclan.co.za/auth/crm/hubspot/callback
CRM_SALESFORCE_OAUTH_CLIENT_ID=
CRM_SALESFORCE_OAUTH_CLIENT_SECRET=
CRM_SALESFORCE_OAUTH_REDIRECT_URI=https://app.chatclan.co.za/auth/crm/salesforce/callback
CRM_SALESFORCE_API_VERSION=v67.0
CRM_ZOHO_OAUTH_CLIENT_ID=
CRM_ZOHO_OAUTH_CLIENT_SECRET=
CRM_ZOHO_OAUTH_REDIRECT_URI=https://app.chatclan.co.za/auth/crm/zoho/callback
# Override these two URLs for the tenant's Zoho data centre when required.
CRM_ZOHO_OAUTH_AUTHORIZE_URL=https://accounts.zoho.com/oauth/v2/auth
CRM_ZOHO_OAUTH_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
CRM_PIPEDRIVE_OAUTH_CLIENT_ID=
CRM_PIPEDRIVE_OAUTH_CLIENT_SECRET=
CRM_PIPEDRIVE_OAUTH_REDIRECT_URI=https://app.chatclan.co.za/auth/crm/pipedrive/callback

MAIL_MODE=mock
MAIL_FROM="ChatClan <no-reply@chatclan.co.za>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Leave DB_HOST blank to run against built-in demo data.
DB_HOST=
DB_PORT=3306
DB_NAME=chatclan
DB_USER=chatclan_user
DB_PASSWORD=change-me

